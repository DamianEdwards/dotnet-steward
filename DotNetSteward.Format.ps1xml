<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>DotNetSteward.AvailableRelease.Table</Name>
      <ViewSelectedBy>
        <TypeName>DotNetSteward.AvailableRelease</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Product</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Version</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Architecture</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Support</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Release type</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>ProductType</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Version</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Architecture</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>SupportPhase</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ReleaseType</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>DotNetSteward.Installation.Table</Name>
      <ViewSelectedBy>
        <TypeName>DotNetSteward.Installation</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Product</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Version</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Architecture</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Managed by</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Updateable</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>EOL date</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Days to EOL</Label>
            <Width>11</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Status</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>ProductType</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Version</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Architecture</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ManagementSource</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IsUpdateable</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($null -ne $_.EndOfSupportDate) { $_.EndOfSupportDate.ToString('yyyy-MM-dd', [System.Globalization.CultureInfo]::InvariantCulture) }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($null -ne $_.EndOfSupportDate) { [int] [math]::Ceiling(($_.EndOfSupportDate - [datetime]::Now).TotalDays) }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $status = [string] $_.SupportStatus
                  $colorName = switch -Wildcard ($status) {
                      'Up to date.' { 'Green' }
                      'Patch * is available.' { 'Yellow' }
                      '.NET * is going out of support soon.' { 'Yellow' }
                      '.NET * is out of support.' { 'Red' }
                  }
                  if ([string]::IsNullOrEmpty($colorName)) {
                      return $status
                  }
                  $icon = switch ($colorName) {
                      'Green' { [char] 0x2713 }
                      'Yellow' { [char] 0x26A0 }
                      'Red' { [char] 0x2717 }
                  }
                  $displayStatus = "$icon $status"
                  if ($PSVersionTable.PSVersion -lt [version] '7.2' -or
                      -not $Host.UI.SupportsVirtualTerminal -or
                      $PSStyle.OutputRendering -eq 'PlainText') {
                      return $displayStatus
                  }
                  $color = $PSStyle.Foreground.$colorName
                  if ([string]::IsNullOrEmpty($color)) {
                      return $displayStatus
                  }
                  return "$color$displayStatus$($PSStyle.Reset)"
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
            <Wrap />
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
