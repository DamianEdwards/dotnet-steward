<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>DotNetSteward.AvailableRelease.Table</Name>
      <ViewSelectedBy>
        <TypeName>DotNetSteward.AvailableRelease</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Product</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Version</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Architecture</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Support</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Release type</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>ProductType</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Version</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Architecture</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>SupportPhase</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ReleaseType</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>DotNetSteward.Installation.Table</Name>
      <ViewSelectedBy>
        <TypeName>DotNetSteward.Installation</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Product</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Version</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Architecture</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Managed by</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Updateable</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>EOL date</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Days to EOL</Label>
            <Width>11</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Status</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>ProductType</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Version</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Architecture</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ManagementSource</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IsUpdateable</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($null -ne $_.EndOfSupportDate) { $_.EndOfSupportDate.ToString('yyyy-MM-dd', [System.Globalization.CultureInfo]::InvariantCulture) }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($null -ne $_.EndOfSupportDate) { [int] [math]::Ceiling(($_.EndOfSupportDate - [datetime]::Now).TotalDays) }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>SupportStatus</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
            <Wrap />
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
